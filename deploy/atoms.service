[Unit]
Description=Atoms Mini Full-Stack AI Builder
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/atoms
# Server loads layered env files itself:
#   .env.production.local -> .env.production -> .env.local -> .env
Environment=APP_ENV=production
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=768
ExecStart=/usr/bin/node /opt/atoms/server/dist/index.js
Restart=always
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
