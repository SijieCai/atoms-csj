# Server
PORT=3000
NODE_ENV=development
DATA_DIR=./data

# Auth: comma-separated username:password pairs (no registration needed for demo)
DEMO_USERS=demo:atoms2026,alice:atoms2026,bob:atoms2026
SESSION_SECRET=change-me-to-a-long-random-secret-in-production

# Zhipu GLM API Configuration
# - China GLM Coding Plan: https://open.bigmodel.cn/api/coding/paas/v4
# - China Pay-as-you-go:   https://open.bigmodel.cn/api/paas/v4
# - Global Z.AI Coding:    https://api.z.ai/api/coding/paas/v4
GLM_API_KEY=your-glm-api-key-here
GLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
GLM_MODEL=glm-4.7
# Optional separate faster model for chat & intent routing (defaults to GLM_MODEL)
GLM_CHAT_MODEL=

# Agent & Preview Sandbox Limits
AGENT_TIMEOUT_MS=480000
MAX_CONCURRENT_AGENTS=2
PREVIEW_PORT_START=14000
PREVIEW_PORT_END=14200
PREVIEW_IDLE_TTL_MS=1800000
