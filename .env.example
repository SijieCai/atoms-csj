# Environment & Server
# 运行环境默认由命令决定：
# - 开发环境 (`npm run dev`): 自动加载 .env.development + .env
# - 线上环境 (`npm run start` / systemd): 自动加载 .env.production + .env
# 本文件 (.env) 适合存放共享密钥与账号；单环境覆盖请使用 .env.development.local / .env.production.local
PORT=3000
DATA_DIR=./data
# Optional overrides (defaults come from .env.development / .env.production)
# PUBLIC_DOMAIN=atoms.maplink.site
# PUBLIC_URL=https://atoms.maplink.site
# COOKIE_SECURE=true
# TRUST_PROXY=1

# Auth: comma-separated username:password pairs (no registration needed for demo)
DEMO_USERS=demo:atoms2026,alice:atoms2026,bob:atoms2026
SESSION_SECRET=change-me-to-a-long-random-secret-in-production

# Zhipu GLM API Configuration
# 注意：智谱「通用按量标准 API Key」与「GLM Coding Plan 套餐 Key」互不通用，请匹配对应端点：
# - 通用按量标准 API (推荐): https://open.bigmodel.cn/api/paas/v4
# - GLM Coding Plan 套餐:    https://open.bigmodel.cn/api/coding/paas/v4
# - 海外 Z.AI Coding:        https://api.z.ai/api/coding/paas/v4
GLM_API_KEY=your-glm-api-key-here
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.3-flash
# Optional separate faster model for chat & intent routing (defaults to GLM_MODEL)
GLM_CHAT_MODEL=glm-5.3-flash

# Optional Deep Research Web Search / Crawler API keys (leave blank to use built-in zero-key federated search & fetcher)
# TAVILY_API_KEY=
# FIRECRAWL_API_KEY=

# Agent & Preview Sandbox Limits
# Hard max duration (30m) + idle watchdog (5m with zero agent activity)
AGENT_TIMEOUT_MS=1800000
AGENT_IDLE_TIMEOUT_MS=300000
MAX_CONCURRENT_AGENTS=2
PREVIEW_PORT_START=14000
PREVIEW_PORT_END=14200
PREVIEW_IDLE_TTL_MS=1800000
